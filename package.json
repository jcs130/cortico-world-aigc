{
  "name": "cortico-world-aigc",
  "version": "0.1.0-rc.2",
  "description": "Independent image, video and music creation World with shared assets, explicit providers and durable jobs",
  "type": "module",
  "license": "(MIT AND AGPL-3.0-only)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcs130/cortico-world-aigc.git"
  },
  "engines": {
    "node": ">=22.14"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./persona": {
      "types": "./dist/persona/index.d.ts",
      "default": "./dist/persona/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "default": "./dist/mcp/server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "agent-aigc-mcp": "./dist/mcp/stdio.js"
  },
  "keywords": [
    "cortico-world",
    "aigc",
    "image-generation",
    "video",
    "music",
    "mcp"
  ],
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "AIGC 创作室",
    "tags": [
      "creative",
      "external-setup",
      "experimental",
      "internal-state",
      "unsafe",
      "high-cost"
    ],
    "describe": "describe.json"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "skills",
    "licenses",
    "docs",
    "examples",
    "providers",
    "describe.json",
    "tsconfig.core.json",
    "tsconfig.json",
    "tsconfig.build.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:core": "tsc -p tsconfig.core.json",
    "test": "node node_modules/vitest/vitest.mjs run --pool=forks --maxWorkers=2 --minWorkers=1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "peerDependencies": {
    "cortico": ">=0.2.4 <0.3.0"
  },
  "peerDependenciesMeta": {
    "cortico": {
      "optional": true
    }
  },
  "devDependencies": {
    "cortico": "0.2.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
